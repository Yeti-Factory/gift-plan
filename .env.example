# ---- Public (build-time, inlined by Vite) ----
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=xxxx

# ---- Server runtime ----
NODE_ENV=production
PORT=3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
APP_URL=https://gift-plan.tondomaine.com
RESEND_API_KEY_GIFT_PLAN=re_xxx

# ---- Signature du webhook email (obligatoire en production) ----
# Le broker Lovable signe X-Lovable-Signature avec LOVABLE_API_KEY. La même clé
# doit donc être disponible au runtime dans Coolify. Ne l'expose jamais côté Vite.
LOVABLE_API_KEY=lovable_xxx

# Secret de rotation facultatif. Il n'est PAS lu dans un header brut : il ne
# fonctionne que si l'émetteur signe aussi X-Lovable-Signature avec cette valeur.
# AUTH_EMAIL_WEBHOOK_SECRET=change-me-64-chars

# ---- Stripe (BYOK, tache a venir) ----
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx
