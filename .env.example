# ---- Public (build-time, inlined by Vite) ----
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=xxxx

# ---- Server runtime ----
NODE_ENV=production
PORT=3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
APP_URL=https://gift-plan.tondomaine.com
RESEND_API_KEY_GIFT_PLAN=re_xxx

# ---- Signature du hook email Supabase (obligatoire en production) ----
# Dans Supabase : Authentication > Hooks > Send Email > HTTP Hook.
# Copie ici l'intégralité du secret généré, sans l'exposer côté Vite.
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxx

# Compatibilité facultative avec l'ancien broker Lovable. Ces variables ne sont
# utiles que si ce broker signe encore X-Lovable-Signature.
# LOVABLE_API_KEY=lovable_xxx
# AUTH_EMAIL_WEBHOOK_SECRET=change-me-64-chars

# ---- Stripe (BYOK, tache a venir) ----
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx
