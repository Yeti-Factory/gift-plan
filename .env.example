NODE_ENV=production
PORT=3000
APP_URL=https://gift-plan.yeti-lab.fr
BETTER_AUTH_SECRET=genere_une_valeur_aleatoire_d_au_moins_32_caracteres
DATABASE_URL=postgresql://gift_plan:mot_de_passe_url_encode@postgres:5432/gift_plan
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
UPLOAD_DIR=/data/uploads
AUTH_EMAIL_FROM=Gift-Plan <noreply@yeti-lab.fr>
RESEND_API_KEY_GIFT_PLAN=re_xxx
STORAGE_CLEANUP_SECRET=genere_une_autre_valeur_aleatoire_d_au_moins_32_caracteres

# Connexion Google facultative : renseigner les deux valeurs, ou aucune.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base PostgreSQL du docker-compose.
POSTGRES_DB=gift_plan
POSTGRES_USER=gift_plan
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_long

# Stripe reste volontairement hors périmètre pour le moment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
