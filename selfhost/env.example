# Copie ces valeurs dans les variables d'environnement Coolify. Ne commite jamais les vraies valeurs.
APP_URL=https://gift-plan.yeti-lab.fr
BETTER_AUTH_SECRET=genere_une_valeur_aleatoire_d_au_moins_32_caracteres
DATABASE_URL=postgresql://gift_plan:mot_de_passe_url_encode@postgres:5432/gift_plan
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
UPLOAD_DIR=/data/uploads
AUTH_EMAIL_FROM=Gift-Plan <noreply@yeti-lab.fr>
RESEND_API_KEY_GIFT_PLAN=

# Optionnel : connexion Google. Laisser les deux vides pour la désactiver.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Variables du conteneur PostgreSQL (base inaccessible depuis Internet).
POSTGRES_DB=gift_plan
POSTGRES_USER=gift_plan
POSTGRES_PASSWORD=remplacer_par_un_mot_de_passe_long

